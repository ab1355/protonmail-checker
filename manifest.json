{
  "manifest_version": 2,
  "name": "Inbox Checker for ProtonMail",
  "version": "3.2",
  "description": "Checks unread e-mails in the ProtonMail Inbox and provides an inbox management agent.",
  "icons": {
    "48" : "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_icon": "icons/icon-48g.png",
    "default_title": "Inbox Checker for ProtonMail",
    "default_popup": "html/popup.html"
  },
  "background": {
    "scripts": [
      "scripts/background.js"
    ]
  },
  "options_page": "html/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://mail.protonmail.com/*"
      ],
      "js": [
        "scripts/contentscript.js",
        "scripts/agent.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "icons/icon-48.png"
  ],
  "permissions": [
    "notifications",
    "tabs"
  ]
}
